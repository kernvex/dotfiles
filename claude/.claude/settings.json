{
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "NotebookEdit",
      "ReportFindings",
      "ScheduleWakeup"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "disableRemoteControl": false,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "python3 $HOME/.claude/statusline-pace.py",
    "padding": 0
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false,
    "document-skills@anthropic-agent-skills": true,
    "project-planning@britt": false,
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "britt": {
      "source": {
        "source": "github",
        "repo": "britt/claude-code-skills"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "effortLevel": "high",
  "remote": {
    "defaultEnvironmentId": "env_01VDSo9VAKGDL1L1T4Z6enoc"
  },
  "tui": "default",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/claude-tmux-track\""
          }
        ]
      }
    ]
  }
}
