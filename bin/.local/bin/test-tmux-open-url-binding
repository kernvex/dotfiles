#!/usr/bin/env bash
# Tests for the `prefix + u` BINDING — what tmux actually hands the picker.
#
#   ./test-tmux-open-url-binding     exit 0 = pass
#
# test-tmux-open-url covers the extraction, and went on covering it happily while
# the feature was completely dead: the picker was never reached, because the pane
# id never arrived. This file covers the step in between, and that step can only
# be tested against a real tmux, so it runs one.
#
# THE BUG THIS EXISTS FOR: `display-popup` does NOT expand `#{...}` in its
# shell-command. It is not `display-message`, and neither `-e` nor a separate
# argv changes it. Bound directly, the picker was handed the eleven literal
# characters `#{pane_id}`, `capture-pane` answered "can't find pane", `set -e`
# killed the script before it could report anything, and the popup opened and
# shut. Pressing the key looked like the key doing nothing at all.
#
# HOW IT IS DRIVEN, and why each piece has to be that way:
#   a scratch server on its own socket sources this checkout's tmux.conf, so what
#     is under test is the conf, not a copy of the binding retyped here;
#   a client is attached through a pty, because a popup needs one — without a
#     client tmux returns 0 and runs nothing, which looks exactly like a pass;
#   the bound command is read back out with list-keys, written to a file and
#     sourced, so tmux re-parses its own output and no shell gets to mangle the
#     nested quoting on the way;
#   HOME points at a fixture whose .local/bin/tmux-open-url is a stub, so the
#     path in the conf is exercised as written rather than substituted — that is
#     the only thing that can catch the path itself breaking.
# The assertion is always on WHAT THE STUB RECEIVED.
set -uo pipefail

HERE="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONF="$(cd -P "$HERE/../../../tmux" && pwd)/.tmux.conf"
[ -f "$CONF" ] || { echo "cannot find tmux.conf at $CONF"; exit 1; }

command -v script >/dev/null 2>&1 || { echo "SKIP: no script(1) to make a pty with"; exit 0; }

# A fresh socket name per run. Reusing one races a server that is still shutting
# down, and the attach then lands on the dying one — measured as an intermittent
# empty client list, which would have read as a real failure.
SOCK="open-url-binding-$$-$RANDOM"
T() { tmux -L "$SOCK" "$@"; }

WORK="$(mktemp -d)"
FAKE_HOME="$WORK/home"
GOT="$WORK/received"
CMDFILE="$WORK/bound.tmux"
mkdir -p "$FAKE_HOME/.local/bin"
# Real ~/.tmux, so the conf's TPM bootstrap finds the plugins already on disk
# and does not try to clone them over the network into the fixture.
ln -s "$HOME/.tmux" "$FAKE_HOME/.tmux" 2>/dev/null

cat > "$FAKE_HOME/.local/bin/tmux-open-url" <<STUBEOF
#!/bin/sh
# The record path is BAKED IN rather than passed through the environment: the
# popup is spawned by the tmux SERVER, which never sees a variable exported
# beside a client command.
printf '%s' "\$1" > "$GOT"
STUBEOF
chmod +x "$FAKE_HOME/.local/bin/tmux-open-url"

CLIENT_PID=""
cleanup() {
  [ -n "$CLIENT_PID" ] && kill "$CLIENT_PID" 2>/dev/null
  T kill-server 2>/dev/null
  rm -rf "$WORK"
}
trap cleanup EXIT

PASS=0
FAIL=0
ok()  { PASS=$((PASS + 1)); }
bad() { FAIL=$((FAIL + 1)); printf '  FAIL  %s\n        %s\n' "$1" "$2"; }

# Poll for a condition rather than sleeping a fixed amount: run-shell -b is
# asynchronous, so a fixed sleep is either a flake or a tax on every run.
until_ok() { # <seconds> <command...>
  local deadline=$(( $(date +%s) + $1 )); shift
  while [ "$(date +%s)" -lt "$deadline" ]; do
    "$@" && return 0
    sleep 0.1
  done
  return 1
}

have_client() { [ "$(T list-clients 2>/dev/null | wc -l | tr -d ' ')" -gt 0 ]; }
have_record() { [ -s "$GOT" ]; }

HOME="$FAKE_HOME" T -f "$CONF" new-session -d -s s1 -x 80 -y 24 'sleep 600' \
  || { echo "could not start scratch server"; exit 1; }

script -q /dev/null tmux -L "$SOCK" attach -t s1 >/dev/null 2>&1 &
CLIENT_PID=$!
until_ok 10 have_client || { echo "SKIP: no client attached; a popup cannot run without one"; exit 0; }

# Read the command back out of the server, so the conf is what is exercised.
# list-keys prints commands in a form tmux can re-source, which is why this goes
# through a file rather than through the shell.
extract_binding() {
  local raw
  raw="$(T list-keys -T prefix | grep -E '^bind-key[[:space:]]+-T prefix[[:space:]]+u[[:space:]]')"
  [ -n "$raw" ] || { echo "no 'bind u' found in $CONF"; exit 1; }
  raw="${raw#*bind-key}"; raw="${raw#*-T prefix}"; raw="${raw#*u}"
  printf '%s\n' "$raw" > "$CMDFILE"
}
extract_binding

press_prefix_u() {
  rm -f "$GOT"
  T source-file "$CMDFILE" 2>/dev/null
  until_ok 10 have_record
}

# --------------------------------------------------------------------------
# The regression. A real pane id, and specifically the one the key was pressed
# in. The literal '#{pane_id}' the broken binding delivered fails this loudest.
# --------------------------------------------------------------------------
PANE="$(T list-panes -t s1 -F '#{pane_id}' -f '#{pane_active}')"
if press_prefix_u; then
  received="$(cat "$GOT")"
  case "$received" in
    %[0-9]*) ok ;;
    *) bad "the picker is handed a real pane id" \
           "got [$received] — an unexpanded format means nothing substituted it" ;;
  esac
  if [ "$received" = "$PANE" ]; then ok
  else bad "the id is the pane the key was pressed in" "want [$PANE] got [$received]"; fi

  # Correct-but-unusable is the same outage: an id arriving quoted, escaped or
  # still wrapped in braces fails here even if it contains the right digits.
  if T capture-pane -p -t "$received" >/dev/null 2>&1; then ok
  else bad "tmux can address the id the picker was given" \
           "capture-pane rejected [$received], which is exactly how the outage began"; fi
else
  bad "the picker runs at all" "the stub was never invoked — the popup command died first"
  bad "the id is the pane the key was pressed in" "no id was delivered"
  bad "tmux can address the id the picker was given" "no id was delivered"
fi

# --------------------------------------------------------------------------
# It must FOLLOW the active pane. A binding resolving to "the session" or "the
# first pane" passes everything above with one pane on screen and is wrong the
# moment the window is split — which is most of the time.
# --------------------------------------------------------------------------
T split-window -t s1 -d 'sleep 600' >/dev/null 2>&1
SECOND="$(T list-panes -t s1 -F '#{pane_id}' | grep -v "^$PANE$" | head -1)"
T select-pane -t "$SECOND"
if press_prefix_u; then
  received="$(cat "$GOT")"
  if [ "$received" = "$SECOND" ]; then ok
  else bad "with the window split, the id follows the active pane" \
           "made [$SECOND] active, picker got [$received]"; fi
else
  bad "with the window split, the picker still runs" "the stub was never invoked"
fi
T select-pane -t "$PANE"

# --------------------------------------------------------------------------
# The tmux fact the binding is SHAPED around, asserted directly so the reason
# for the shape is checkable rather than folklore. If this ever fails, tmux has
# gained the expansion and the binding can be simplified back.
# --------------------------------------------------------------------------
rm -f "$GOT"
T display-popup -E "$FAKE_HOME/.local/bin/tmux-open-url '#{pane_id}'" 2>/dev/null
if until_ok 10 have_record; then
  if [ "$(cat "$GOT")" = '#{pane_id}' ]; then ok
  else bad "display-popup still does not expand formats in its command" \
           "it delivered [$(cat "$GOT")] — if that is a real pane id, tmux now expands and the run-shell hop is redundant"; fi
else
  bad "display-popup runs its command at all" "nothing was recorded"
fi

# --------------------------------------------------------------------------
# And when something DOES go wrong, it has to be visible. Every cause of the
# original outage produced the same thing on screen — a popup that opened and
# shut — because the script died under `set -e` before reaching any message.
# These drive the real script, not the stub, against failures it must survive
# long enough to explain. A silent exit 0 here is the outage coming back.
# --------------------------------------------------------------------------
SUT="$HERE/tmux-open-url"
SOCKET_PATH="$(T display-message -p '#{socket_path}')"
SERVER_PID="$(T display-message -p '#{pid}')"
export TMUX="$SOCKET_PATH,$SERVER_PID,0"

# A pane id it cannot read — which is precisely what the broken binding handed
# it, eleven literal characters and all.
out="$("$SUT" '#{pane_id}' 2>&1 </dev/null)"; rc=$?
if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -q 'cannot read pane'; then ok
else bad "an unreadable pane is reported, not died on"          "exit $rc, output [$out] — this is the shape the outage had"; fi

# No picker on PATH. `|| exit 0` used to read this as "the user pressed Escape".
LINKPANE="$(T new-window -P -F '#{pane_id}' 'printf "see https://example.com/x\n"; sleep 600')"
sleep 0.3
NOFZF="$WORK/nofzf"; mkdir -p "$NOFZF"
ln -s "$(command -v tmux)" "$NOFZF/tmux" 2>/dev/null
out="$(PATH="$NOFZF:/usr/bin:/bin" "$SUT" "$LINKPANE" 2>&1 </dev/null)"; rc=$?
if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -qi 'fzf'; then ok
else bad "a missing picker is reported, not read as a cancel"          "exit $rc, output [$out]"; fi

unset TMUX

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
