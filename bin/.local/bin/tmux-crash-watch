#!/bin/bash
# tmux-crash-watch — 48-hour tmux crash monitor, installed 2026-08-11.
#
# Context: tmux 3.7b's copy-mode entry aborted the server 4x on 2026-08-11
# (upstream tmux#5302/#5385, macOS libmalloc). The binary is now a jemalloc-
# linked 3.7c and mouse is off; this watches whether that actually killed it.
#
# Three duties:
#   1. tmux hooks append every copy-mode entry/exit and client event to
#      events.log — the precursor trail, since the crash fires ON copy-mode
#      entry. Hooks die with the server, so each loop re-installs them on any
#      server that lacks the @crashwatch marker (covers continuum restores).
#   2. Every 15s, sample server pid/RSS/pane counts to samples.log and scan
#      ~/Library/Logs/DiagnosticReports for new tmux-*.ips. A new report =>
#      bundle it with the log tails, the unified log for tmux, and vm_stat
#      into crashes/<timestamp>/, and raise a macOS notification.
#   3. After the 48h deadline (persisted in `deadline`, so launchd restarts
#      and reboots do not extend it): remove hooks, delete the LaunchAgent
#      plist, and bootout — logs are kept, the watcher is gone.
#
# Runs under launchd as com.kernvex.tmux-crash-watch (KeepAlive). Also the
# hook target: `tmux-crash-watch --event ...` just appends a line and exits.
LABEL="com.kernvex.tmux-crash-watch"
STATE="$HOME/.local/state/tmux-crash-watch"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
REPORTS="$HOME/Library/Logs/DiagnosticReports"
HOOKS="pane-mode-changed client-attached client-detached client-resized session-created session-closed"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
mkdir -p "$STATE/crashes"

ts() { date '+%Y-%m-%d %H:%M:%S'; }

if [ "$1" = "--event" ]; then
    shift
    echo "$(ts) EVENT $*" >> "$STATE/events.log"
    exit 0
fi

[ -f "$STATE/deadline" ] || date -v+48H +%s > "$STATE/deadline"
DEADLINE=$(cat "$STATE/deadline")
START=$((DEADLINE - 172800))
SEEN="$STATE/seen-reports"
touch "$SEEN"
echo "$(ts) WATCH starting (pid $$, deadline $(date -r "$DEADLINE" '+%F %T'))" >> "$STATE/watch.log"

install_hooks() {
    local self="$HOME/.local/bin/tmux-crash-watch" h
    for h in $HOOKS; do
        tmux set-hook -g "$h" \
            "run-shell -b \"$self --event $h session=#{session_name} pane=#{pane_id} mode=#{pane_mode} cmd=#{pane_current_command}\"" \
            2>/dev/null
    done
    tmux set -g @crashwatch 1 2>/dev/null
    echo "$(ts) WATCH hooks installed on server pid $(tmux display -p '#{pid}' 2>/dev/null)" >> "$STATE/watch.log"
}

remove_hooks() {
    local h
    for h in $HOOKS; do tmux set-hook -gu "$h" 2>/dev/null; done
    tmux set -gu @crashwatch 2>/dev/null
}

bundle_crash() {
    local ips="$1" d="$STATE/crashes/$(date +%Y%m%dT%H%M%S)"
    mkdir -p "$d"
    cp "$ips" "$d/"
    tail -500 "$STATE/events.log"  > "$d/events-tail.log"  2>/dev/null
    tail -200 "$STATE/samples.log" > "$d/samples-tail.log" 2>/dev/null
    log show --predicate 'process == "tmux"' --last 20m > "$d/unified-log-tmux.txt" 2>&1
    vm_stat > "$d/vm_stat.txt" 2>&1
    echo "$(ts) CRASH captured: $(basename "$ips") -> $d" >> "$STATE/watch.log"
    osascript -e "display notification \"Crash captured to $d\" with title \"tmux-crash-watch\"" 2>/dev/null
}

while :; do
    if [ "$(date +%s)" -ge "$DEADLINE" ]; then
        remove_hooks
        echo "$(ts) WATCH 48h window over — uninstalling (logs kept in $STATE)" >> "$STATE/watch.log"
        rm -f "$PLIST"
        exec launchctl bootout "gui/$(id -u)/$LABEL"
    fi

    for f in "$REPORTS"/tmux-*.ips; do
        [ -e "$f" ] || continue
        grep -qxF "$f" "$SEEN" && continue
        echo "$f" >> "$SEEN"
        # pre-existing reports (the four from before install) are seen, not bundled
        [ "$(stat -f %m "$f")" -ge "$START" ] && bundle_crash "$f"
    done

    PID=$(tmux display -p '#{pid}' 2>/dev/null)
    if [ -n "$PID" ]; then
        [ "$(tmux show -gv @crashwatch 2>/dev/null)" = "1" ] || install_hooks
        echo "$(ts) SAMPLE pid=$PID rss_kb=$(ps -o rss= -p "$PID" | tr -d ' ')" \
             "sessions=$(tmux ls 2>/dev/null | wc -l | tr -d ' ')" \
             "panes=$(tmux list-panes -a 2>/dev/null | wc -l | tr -d ' ')" \
             "panes_in_mode=$(tmux list-panes -a -F '#{pane_in_mode}' 2>/dev/null | grep -c 1)" \
             >> "$STATE/samples.log"
        echo "$PID" > "$STATE/server.pid"
    elif [ -s "$STATE/server.pid" ]; then
        echo "$(ts) SERVER GONE (was pid $(cat "$STATE/server.pid")) — crash if an .ips follows, clean kill otherwise" >> "$STATE/watch.log"
        : > "$STATE/server.pid"
    fi

    sleep 15
done
