#!/usr/bin/env bash
# Tests for tmux-open-path's extraction — the pure seam.
#
#   ./test-tmux-open-path     exit 0 = pass
#
# Pane text in, candidate list out. No tmux, no fzf, no editor.
#
# EXISTENCE IS THE FILTER, and these tests are what pin it down. Almost any word
# can look like a path, so the recogniser is deliberately generous and every
# candidate is then resolved and dropped unless it is a file that is really
# there. That is what keeps the list readable without brittle pattern rules — and
# it is why these run against a fixture tree, so "exists" is something the test
# controls rather than a property of the machine it runs on.
#
# Each line is  <display>\t<absolute path>\t<line>  — line is empty when the text
# did not carry one.
set -uo pipefail

HERE="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUT="$HERE/tmux-open-path"
[ -x "$SUT" ] || { echo "cannot find tmux-open-path beside this test"; exit 1; }

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
ROOT="$(cd -P "$WORK" && pwd)"

PASS=0
FAIL=0
ok()  { PASS=$((PASS + 1)); }
bad() { FAIL=$((FAIL + 1)); printf '  FAIL  %s\n        %s\n' "$1" "$2"; }
same() {
  if [ "$2" = "$3" ]; then ok
  else bad "$1" "want: [${2//$'\n'/ | }]
        got:  [${3//$'\n'/ | }]"; fi
}

# HOME is pointed at the fixture so that `~` expansion is testable without
# depending on anything in the real home directory.
run()      { printf '%s' "$1" | HOME="$ROOT" "$SUT" --extract "$ROOT/proj" 2>/dev/null; }
displays() { run "$1" | cut -f1; }
paths()    { run "$1" | cut -f2; }
lines()    { run "$1" | cut -f3; }

# ---------------------------------------------------------------- fixtures ---
mkdir -p "$ROOT/proj/src" "$ROOT/proj/docs" "$ROOT/elsewhere" "$ROOT/proj/adir"
printf 'x\n' > "$ROOT/proj/src/main.ts"
printf 'x\n' > "$ROOT/proj/src/other.ts"
printf 'x\n' > "$ROOT/proj/README.md"
printf 'x\n' > "$ROOT/proj/docs/guide.md"
printf 'x\n' > "$ROOT/elsewhere/far.txt"
printf 'x\n' > "$ROOT/home-file.md"
printf 'x\n' > "$ROOT/proj/a file.md"

# ------------------------------------------------------------------- cases ---

same "a relative path is resolved against the pane's directory" \
  "$ROOT/proj/src/main.ts" \
  "$(paths 'ERROR in src/main.ts')"

same "an absolute path is found" \
  "$ROOT/elsewhere/far.txt" \
  "$(paths "see $ROOT/elsewhere/far.txt for details")"

same "a ~ path is expanded and found" \
  "$ROOT/home-file.md" \
  "$(paths 'wrote ~/home-file.md')"

same "a ./ path is found" \
  "$ROOT/proj/README.md" \
  "$(paths 'cat ./README.md')"

# The whole point of pairing this with an editor: arrive where the failure is.
same "a trailing :line is captured as the line" \
  "3" \
  "$(lines 'FAIL src/main.ts:3')"

same "a trailing :line is not left on the path" \
  "$ROOT/proj/src/main.ts" \
  "$(paths 'FAIL src/main.ts:3')"

same "a :line:col keeps the line and drops the column" \
  "42" \
  "$(lines 'src/main.ts:42:8: error: bad')"

same "a path with no line number reports no line" \
  "" \
  "$(lines 'see src/main.ts')"

# The filter. Without it the list is every word on screen.
same "a path that does not exist is dropped" \
  "" \
  "$(paths 'ERROR in src/nope.ts')"

same "a word that merely looks like a path is dropped" \
  "" \
  "$(paths 'the ratio was 3/4 and the rate 10/sec')"

# Written as ./adir so it survives the cheap line pre-filter and actually
# reaches the existence check. Spelled bare, this case passed against a script
# testing -e rather than -f — the pre-filter dropped the line and nothing about
# directories was ever exercised.
same "a directory is not offered as a file" \
  "" \
  "$(paths 'look in ./adir for it')"

# Most recent first, deduped keeping the recent one — tmux-open-url's rule,
# because the reason for it is the same: the line you are reacting to is the one
# that just printed.
same "the most recently printed path is first" \
  "$ROOT/proj/docs/guide.md
$ROOT/proj/src/main.ts" \
  "$(paths 'first src/main.ts
then docs/guide.md')"

same "a path printed twice appears once, at its most recent position" \
  "$ROOT/proj/src/main.ts
$ROOT/proj/src/other.ts" \
  "$(paths 'src/main.ts
src/other.ts
src/main.ts')"

# ONE FILE AT TWO LINES IS TWO DESTINATIONS. De-duplication is on the path AND
# the line, not the path alone: a compiler naming the same file at 4 and at 9 is
# offering two places to go, and collapsing them would throw away the one you
# were not shown. The spec said "listed once" of a repeated path, which this
# still honours — the case above proves it.
same "the same file at two different lines is offered twice" \
  "src/main.ts:9
src/main.ts:4" \
  "$(displays 'a src/main.ts:4
b src/main.ts:9')"

# Trailing punctuation, by the same rules tmux-open-url applies to links.
same "a trailing full stop is not part of the path" \
  "$ROOT/proj/README.md" \
  "$(paths 'edit ./README.md.')"

same "a path in parentheses comes out unwrapped" \
  "$ROOT/proj/src/main.ts" \
  "$(paths 'the entry (src/main.ts) is wrong')"

same "a quoted path comes out unquoted" \
  "$ROOT/proj/src/main.ts" \
  "$(paths 'File "src/main.ts", line 3')"

same "a quoted path still yields its line" \
  "3" \
  "$(lines 'File "src/main.ts", line 3')"

# Real output shapes.
same "git status output yields its files" \
  "$ROOT/proj/README.md
$ROOT/proj/src/main.ts" \
  "$(paths '	modified:   src/main.ts
	modified:   README.md')"

same "a stack frame yields its file and line" \
  "$ROOT/proj/src/main.ts" \
  "$(paths '    at handler (src/main.ts:12:5)')"

same "a stack frame yields its line number" \
  "12" \
  "$(lines '    at handler (src/main.ts:12:5)')"

# Display is what you read in the picker.
same "the display is relative to the pane's directory" \
  "src/main.ts" \
  "$(displays 'ERROR in src/main.ts')"

# HOME is the fixture root here, so a file outside the pane's directory is still
# under home and shortens. This expectation was originally written to match the
# code rather than the spec, which asks for ~-shortening.
same "a file outside the pane's directory shows a path you can still read" \
  "~/elsewhere/far.txt" \
  "$(displays "see $ROOT/elsewhere/far.txt")"

same "a display carries the line number when there is one" \
  "src/main.ts:3" \
  "$(displays 'FAIL src/main.ts:3')"

# A quoted filename containing spaces is the only form that can be recognised
# unambiguously, and it is the form that tools actually print.
same "a quoted filename with spaces is one path" \
  "$ROOT/proj/a file.md" \
  "$(paths 'opening "a file.md" now')"

# A filename that GENUINELY ends in punctuation. The recogniser strips a
# trailing run before testing, which is right far more often — but it has to be
# able to fall back to the name as printed, or such a file is unreachable.
#
# Ending in `.` rather than `)`: brackets, commas and quotes DELIMIT a token, so
# a name containing one can never be recognised in the first place and no
# fallback could rescue it. `.` `;` `:` `!` `?` are the ones that can both end a
# name and end a sentence, which is exactly the ambiguity the fallback exists for.
printf 'x\n' > "$ROOT/proj/odd."
same "a filename that really ends in punctuation is still found" \
  "$ROOT/proj/odd." \
  "$(paths 'see ./odd.')"

# Outside the pane's directory but under home: shortened, because an absolute
# path here is mostly a prefix you already know.
same "a file under home shows as a ~ path" \
  "~/home-file.md" \
  "$(displays 'wrote ~/home-file.md')"

# EXIT STATUS IS ASSERTED. Text with nothing in it is the ordinary case, and the
# script that dies on it takes the popup down with it — the exact shape of the
# prefix+u outage.
out="$(printf 'just some output\nwith nothing in it\n' | HOME="$ROOT" "$SUT" --extract "$ROOT/proj" 2>&1)"; rc=$?
if [ -z "$out" ] && [ "$rc" -eq 0 ]; then ok
else bad "text with no paths prints nothing and exits 0" "exit $rc, output [$out]"; fi

out="$(printf '' | HOME="$ROOT" "$SUT" --extract "$ROOT/proj" 2>&1)"; rc=$?
if [ -z "$out" ] && [ "$rc" -eq 0 ]; then ok
else bad "empty input prints nothing and exits 0" "exit $rc, output [$out]"; fi

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
