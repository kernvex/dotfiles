#!/usr/bin/env bash
# Tests for copy-mode line numbers and the `:` that lands on the line.
#
#   ./test-tmux-copy-mode-lines     exit 0 = pass
#
# Two scratch tmux servers, both on private sockets, both sourcing this
# checkout's tmux.conf:
#
#   1. INNER alone, driven with `send-keys -X`, for the commands the `:`
#      binding issues. Fast, and enough for everything except the keystroke.
#   2. INNER attached from a pane of OUTER, which is the only way to get a real
#      client onto it. A command-prompt needs one — `send-keys` to a pane while
#      the prompt is open blocks tmux's command queue instead of typing into it —
#      so the actual `:42<CR>` round trip, and the RENDERED gutter, are asserted
#      through the outer pane's capture. The gutter is drawn over the mode's
#      screen and never reaches the inner pane's grid, so outer capture is the
#      only place it is visible at all.
#
# EXIT STATUS IS ASSERTED, not just output — same lesson test-tmux-open-url and
# test-claude-tmux record in their headers.
#
# On restating config: the theme colours and the `:` binding are read back out
# of the running server rather than copied here. The option VALUES this file
# does name (`absolute`, `bold`) are the assertion itself and cannot be read
# from anywhere without asserting nothing.
set -uo pipefail

HERE="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONF="$HERE/../../../tmux/.tmux.conf"
[ -f "$CONF" ] || { echo "cannot find tmux.conf at $CONF"; exit 1; }

IN=copy-lines-inner
OUT=copy-lines-outer
T()  { tmux -L "$IN" "$@"; }
TO() { tmux -L "$OUT" "$@"; }
trap 'T kill-server 2>/dev/null; TO kill-server 2>/dev/null' EXIT

LINES=200
T -f "$CONF" new-session -d -s in -x 80 -y 24 \
  "for i in \$(seq 1 $LINES); do echo \"content-line-\$i\"; done; exec sleep 600" \
  || { echo "could not start scratch server"; exit 1; }

PANE="in:1.0"   # base-index 1

# The theme lands via TPM's run-shell, which can finish after new-session
# returns; the colour assertions below need @thm_* populated.
for _ in $(seq 50); do
  [ -n "$(T show -gv @thm_rosewater 2>/dev/null)" ] && break
  sleep 0.2
done
ROSEWATER="$(T show -gv @thm_rosewater)"
OVERLAY="$(T show -gv @thm_overlay_1)"
[ -n "$ROSEWATER" ] && [ -n "$OVERLAY" ] \
  || { echo "theme never loaded — @thm_* empty"; exit 1; }

# Wait for the history to SETTLE, not merely to pass a threshold: every
# absolute-line coordinate below is derived from history_size, so reading it
# mid-fill would silently skew each one.
prev=-1
for _ in $(seq 100); do
  now="$(T display -p -t "$PANE" '#{history_size}')"
  [ "$now" = "$prev" ] && [ "$now" -gt 0 ] && break
  prev="$now"; sleep 0.2
done
HSIZE="$(T display -p -t "$PANE" '#{history_size}')"
[ "$HSIZE" -gt 0 ] || { echo "history never filled"; exit 1; }
# From here HSIZE is only evidence the fill finished; line_text re-reads it.

# Wired at all? Without this a tmux predating the feature reports a wall of
# opaque failures instead of the one fact that explains them.
case "$(T show -gwv copy-mode-line-numbers 2>/dev/null)" in
  relative) ;;
  *) echo "copy-mode-line-numbers is not relative — is the conf edit in place,"
     echo "and does this tmux ($(T display -p '#{version}')) have the option?"
     exit 1 ;;
esac

PASS=0
FAIL=0
ok()   { PASS=$((PASS + 1)); }
fail() { FAIL=$((FAIL + 1)); printf '  FAIL  %s\n' "$1"; }

assert_eq() { # <desc> <want> <got>
  if [ "$2" = "$3" ]; then ok; else
    fail "$1"; printf '        want: %s\n        got:  %s\n' "$2" "$3"
  fi
}
assert_ne() { # <desc> <unwanted> <got>
  if [ "$2" != "$3" ]; then ok; else
    fail "$1"; printf '        expected anything but: %s\n' "$2"
  fi
}
assert_exit() { # <desc> <want> <got>
  if [ "$2" = "$3" ]; then ok; else
    fail "$1"; printf '        want exit: %s\n        got exit:  %s\n' "$2" "$3"
  fi
}
assert_contains() { # <desc> <needle> <haystack>
  case "$3" in *"$2"*) ok ;; *)
    fail "$1"; printf '        wanted to contain: %s\n        got: %s\n' "$2" "$3" ;;
  esac
}

fmt()  { T display -p -t "$PANE" "$1"; }
x()    { T send-keys -t "$PANE" -X "$@"; }
recopy() { x cancel 2>/dev/null; T copy-mode -t "$PANE"; }

# The text of the line this mode numbers N, fetched WITHOUT copy mode.
# Numbering is bottom-anchored, and capture-pane also counts backwards from the
# visible screen, so the two agree directly: line N is at coordinate -N. No
# history_size in the arithmetic at all, which is what makes this immune to the
# outer client's attach RESIZING the session below — a taller pane pulls lines
# out of history and moves every history-relative coordinate.
line_text() { # <line-number-as-this-mode-counts>
  T capture-pane -p -t "$PANE" -S "-$1" -E "-$1"
}

TARGET=30

# --- static: options and binding, read back off the running server ----------

assert_eq "numbering is relative, so 0 is the cursor and history counts upward" \
  "relative" "$(T show -gwv copy-mode-line-numbers)"
assert_eq "gutter style resolves to the theme's recessive overlay" \
  "fg=$OVERLAY" "$(fmt '#{T:copy-mode-line-number-style}')"
assert_eq "current-line style resolves to the theme's unspent rosewater" \
  "fg=$ROSEWATER,bold" "$(fmt '#{T:copy-mode-current-line-number-style}')"

COLON="$(T list-keys -T copy-mode-vi | grep -E '^bind-key +-T copy-mode-vi +: ')"
assert_contains "\`:\` moves the cursor rather than jumping absolutely" "cursor-up" "$COLON"
assert_contains "\`:\` passes the typed count through" "-N" "$COLON"
case "$COLON" in *goto-line*)
  fail "\`:\` still calls goto-line, which ignores relative numbering" ;;
  *) ok ;;
esac

# --- behavioural: the motion the binding issues -----------------------------
# The fixture prints content-line-1..200, so the line the cursor sits on names
# its own position and "N lines back" can be checked by arithmetic on the text
# rather than by translating screen coordinates.

cursor_num() { # the K in content-line-K under the cursor
  fmt '#{copy_cursor_line}' | sed -n 's/^content-line-\([0-9]*\).*/\1/p'
}

recopy
x history-bottom
x cursor-up            # off the trailing blank, onto real content
start_num="$(cursor_num)"
assert_ne "precondition: cursor is on a numbered fixture line" "" "$start_num"

BACK=15
x -N "$BACK" cursor-up; code=$?
assert_exit "the counted motion exits clean" 0 "$code"
assert_eq "\`:$BACK\` goes exactly $BACK lines back" \
  "$((start_num - BACK))" "$(cursor_num)"

# Again from the new position: the count is always relative to where you are,
# which is the property that lets the gutter be read at any moment.
mid_num="$(cursor_num)"
x -N "$BACK" cursor-up
assert_eq "a second \`:$BACK\` is relative to the new cursor, not the start" \
  "$((mid_num - BACK))" "$(cursor_num)"

# Running past the top scrolls the view rather than stopping at the screen edge.
before_scroll="$(fmt '#{scroll_position}')"
x -N 60 cursor-up
assert_ne "a long motion scrolls the view" "$before_scroll" "$(fmt '#{scroll_position}')"
assert_eq "and still lands exactly 60 back" \
  "$((mid_num - BACK - 60))" "$(cursor_num)"

# A count past the oldest line clamps there instead of erroring.
x -N 999999 cursor-up; code=$?
assert_exit "an over-long count does not error" 0 "$code"
assert_eq "an over-long count clamps at the oldest line held" "1" "$(cursor_num)"
x cancel

# --- the real keystroke, and the rendered gutter ----------------------------
# Everything above drives the commands directly. This drives the KEY, through a
# client that genuinely exists, which is the only way the command-prompt half of
# the binding is exercised at all.

TO new-session -d -s out -x 100 -y 30 "tmux -L $IN attach -t in" \
  || { echo "could not start the outer server"; exit 1; }
for _ in $(seq 50); do
  [ "$(T list-clients 2>/dev/null | wc -l | tr -d ' ')" -gt 0 ] && break
  sleep 0.2
done
assert_ne "an outer client actually attached" "0" \
  "$(T list-clients 2>/dev/null | wc -l | tr -d ' ')"

JUMP=42
T copy-mode -t "$PANE"; sleep 0.4
x history-bottom
x cursor-up
key_start="$(cursor_num)"
TO send-keys -t out ':'; sleep 0.5
TO send-keys -t out "$JUMP"; sleep 0.3
TO send-keys -t out Enter; sleep 0.7

assert_eq "typing \`:$JUMP\` for real goes $JUMP lines back" \
  "$((key_start - JUMP))" "$(cursor_num)"

# Typos must not throw you out of copy mode or move you.
here="$(cursor_num)"
TO send-keys -t out ':'; sleep 0.4; TO send-keys -t out Enter; sleep 0.6
assert_eq "a bare Enter at the prompt is a no-op" "$here" "$(cursor_num)"
assert_eq "and leaves you in copy mode" "1" "$(fmt '#{pane_in_mode}')"
TO send-keys -t out ':'; sleep 0.4; TO send-keys -t out 'abc'; sleep 0.3
TO send-keys -t out Enter; sleep 0.6
assert_eq "a non-numeric count moves nothing" "$here" "$(cursor_num)"
assert_eq "and also leaves you in copy mode" "1" "$(fmt '#{pane_in_mode}')"
# Not silent, unlike the bare Enter above: tmux complains on the status line.
# Asserted so the config comment beside the binding cannot drift from it.
assert_contains "a non-numeric count says so rather than failing quietly" \
  "Repeat count invalid" "$(TO capture-pane -p -t out)"

# The gutter is painted over the mode's screen and never lands in the inner
# pane's grid, so the outer capture is the only place it can be seen. Step the
# cursor down first: a counted motion leaves it on the TOP row, where there is
# nothing above it to number, and the whole point is the numbers going back.
x -N 3 cursor-down; sleep 0.4
mid="$(cursor_num)"
RENDER="$(TO capture-pane -p -t out)"
assert_contains "the cursor's own line is 0" "  0 content-line-$mid" "$RENDER"
assert_contains "one line back is 1" "  1 content-line-$((mid - 1))" "$RENDER"
assert_contains "two lines back is 2" "  2 content-line-$((mid - 2))" "$RENDER"
assert_contains "three lines back is 3" "  3 content-line-$((mid - 3))" "$RENDER"

printf '%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
